# Copy to .env for local development. NEVER commit a real .env. Production values live in the host's secret store.

# ── Required ─────────────────────────────────────────────────────────────────
# Master key (base64 of 32 random bytes) that seals each agent's own AES and HMAC secrets in the database.
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
AES_KEY=

# ── Storage and rate limiting ────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=                      # the service-role key; server-side only
REDIS_URL=redis://localhost:6379   # nonce guard (replay protection) and rate limiter

# ── Browsers ─────────────────────────────────────────────────────────────────
# Comma-separated list of exact origins. A wildcard is refused outside DEV_MODE.
ALLOWED_ORIGINS=https://hbeval.com
PUBLIC_BASE_URL=https://api.example.com
CONSENT_URL=

# ── Hardening switches ───────────────────────────────────────────────────────
MAX_BODY_BYTES=5000000
# Set to "false" once agents.api_key_hash is populated for every agent (see CHANGELOG, 2.13.0).
ALLOW_PLAINTEXT_API_KEY_LOOKUP=true
DAILY_CAP_ENABLED=
OBSERVATORY_SALT=                  # enables anonymous aggregate publishing when set

# ── Optional surfaces (OFF unless set) ───────────────────────────────────────
# Enables /api/v1/enforce/*. At least 24 characters. Callers send it as X-HBEval-Enforce-Key.
HBEVAL_ENFORCE_API_KEY=
# Passport signing (Ed25519). Keep this out of the database it signs.
PASSPORT_SIGNING_KEY=
PASSPORT_KEY_ID=

# ── Local development ONLY. Never set DEV_MODE in production. ────────────────
DEV_MODE=false
DEV_API_KEY=
DEV_AGENT_AES_KEY=
DEV_SIGNING_SECRET=
